<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".screens.weight.PetWeightDeselectionFragment">

    <data>
        <variable
            name="petWeightDeselectionViewModel"
            type="com.hfad.petlogger.screens.weight.PetWeightDeselectionViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <androidx.appcompat.widget.SearchView
                android:id="@+id/search_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:queryHint="@string/search_weights"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/to_keep_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/keeping"
                    android:clickable="true"
                    android:focusable="true"
                    android:checkable="true"
                    android:checked="@{petWeightDeselectionViewModel.toKeepButtonChecked}"
                    android:drawableLeft="@drawable/selection_to_keep"
                    android:drawableRight="@drawable/visibility_on_24px"
                    app:iconGravity="start"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/to_remove_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/removing"
                    android:drawableLeft="@drawable/selection_to_remove"
                    android:drawableRight="@drawable/visibility_on_24px"
                    android:clickable="true"
                    android:focusable="true"
                    android:checkable="true"
                    android:checked="@{petWeightDeselectionViewModel.toRemoveButtonChecked}"
                    app:iconGravity="start" />
            </LinearLayout>
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/weights_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:gravity="top"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </androidx.core.widget.NestedScrollView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reset" />
            </LinearLayout>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>