<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".NewPhotoFragment">

    <data>
        <import type="com.hfad.petlogger.util.DataBindingConverter"/>

        <variable
            name="newPhotoViewModel"
            type="com.hfad.petlogger.NewPhotoViewModel" />

        <variable
            name="petSelectorViewModel"
            type="com.hfad.petlogger.PetMultiSelectionViewModel" />

        <variable
            name="eventSelectorViewModel"
            type="com.hfad.petlogger.EventMultiSelectionViewModel" />

        <variable
            name="weightSelectorViewModel"
            type="com.hfad.petlogger.WeightMultiSelectionViewModel" />
    </data>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/photoDisplay"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/selectPhotoButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/select_photo"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/clearPhotoSelectionButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/clear_photo"/>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/photoTitleTextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/title">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/photoTitleTextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minLines="1"
                            android:text="@={newPhotoViewModel.photoTitle}"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">


                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/photoWidthTextField"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:hint="@string/width_header"
                            android:layout_weight="1">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/photoWidthTextInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minLines="1"
                                android:inputType="number"
                                android:text="@{DataBindingConverter.intToStringMaterial(newPhotoViewModel.photo.width)}"
                                android:enabled="false"/>
                        </com.google.android.material.textfield.TextInputLayout>



                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/photoHeightTextField"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:hint="@string/height_header"
                            android:layout_weight="1">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/photoHeightTextInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minLines="1"
                                android:text="@{DataBindingConverter.intToStringMaterial(newPhotoViewModel.photo.height)}"
                                android:inputType="number"
                                android:enabled="false"/>
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>



                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/photoSizeTextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/file_size_header">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/photoSizeTextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minLines="1"
                            android:text="@{DataBindingConverter.doubleToString(newPhotoViewModel.photo.size)}"
                            android:inputType="number"
                            android:enabled="false"/>
                    </com.google.android.material.textfield.TextInputLayout>



                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/photoDateTextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/date">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/photoDateTextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minLines="1"
                            android:text="@{newPhotoViewModel.photoDate}"
                            android:enabled="false"/>
                    </com.google.android.material.textfield.TextInputLayout>


                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/pet_selection_fragment_container_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:name="com.hfad.petlogger.PetMultiSelectionDisplayFragment"
                        tools:layout="@layout/fragment_pet_multi_selection_display" />

                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/event_selection_fragment_container_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:name="com.hfad.petlogger.EventMultiSelectionDisplayFragment"
                        tools:layout="@layout/fragment_event_multi_selection_display" />

                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/weight_selection_fragment_container_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:name="com.hfad.petlogger.WeightMultiSelectionDisplayFragment"
                        tools:layout="@layout/fragment_weight_multi_selection_display" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submitButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/submit"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clearButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clear"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/back"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</layout>