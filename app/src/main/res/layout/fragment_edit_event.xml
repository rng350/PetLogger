<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".screens.event.editevent.EditEventFragment">
    <data>
        <variable
            name="viewModel"
            type="com.hfad.petlogger.screens.event.editevent.EditEventViewModel" />
        <variable
            name="mediaSelectionViewModel"
            type="com.hfad.petlogger.screens.photo.mediaselection.MediaSelectionViewModel" />
        <variable
            name="petMultiSelectionViewModel"
            type="com.hfad.petlogger.screens.pet.petmultiselection.PetMultiSelectionViewModel" />
        <variable
            name="noteMultiSelectionViewModel"
            type="com.hfad.petlogger.screens.note.notemultiselection.NoteMultiSelectionViewModel" />
        <variable
            name="tagMultiSelectionViewModel"
            type="com.hfad.petlogger.screens.tag.tagmultiselection.TagMultiSelectionViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabMode="fixed"
            app:tabGravity="fill"/>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/submit_changes_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/submit"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/delete_event_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete" />
        </LinearLayout>
    </LinearLayout>
</layout>