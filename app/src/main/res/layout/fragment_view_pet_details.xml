<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".screens.pet.viewpet.PetDetailsFragment">

    <data>
        <variable
            name="viewPetViewModel"
            type="com.hfad.petlogger.screens.pet.viewpet.ViewPetViewModel" />
        <variable
            name="associatedTagsDisplayViewModel"
            type="com.hfad.petlogger.screens.sections.associatedentities.AssociatedTagsDisplayViewModel" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:orientation="vertical">
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/loading_screen_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/loading"
                android:textSize="20sp"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/loading_failed_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/failed_to_load"
                android:textSize="20sp"
                android:gravity="center"/>

            <LinearLayout
                android:id="@+id/pet_details_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/petPhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:maxWidth="200dp"
                    android:scaleType="centerCrop"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/placeholder" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/petNameTextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/pet_name_header">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/petNameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{viewPetViewModel.petDetails.petName}"
                        android:enabled="false"/>
                </com.google.android.material.textfield.TextInputLayout>


                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/petDOBTextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/pet_dob_header">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/petDOBText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{viewPetViewModel.petDetails.petDateOfBirth}"
                        android:enabled="false"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/petDateOfPassingTextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:hint="@string/pet_date_of_passing_header">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/petDateOfPassingText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{viewPetViewModel.petDetails.petDateOfPassing}"
                        android:enabled="false"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/petAgeTextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/pet_age_header">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/petAgeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{viewPetViewModel.petDetails.petAgeDisplay}"
                        android:enabled="false"/>
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/petSpeciesTextField"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/pet_species_header">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/petSpeciesText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@{viewPetViewModel.petDetails.petSpecies}"
                            android:enabled="false"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/petBreedTextField"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:hint="@string/pet_breed_header">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/petBreedText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@{viewPetViewModel.petDetails.petBreed}"
                            android:enabled="false"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/petSexTextField"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/pet_sex_header">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/petSexText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@{viewPetViewModel.petDetails.petSex}"
                            android:enabled="false"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/petWeightAmtTextField"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:layout_marginEnd="2dp"
                        android:hint="@string/pet_latest_weight_header">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/petWeightAmtText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@{viewPetViewModel.petDetails.latestPetWeightAmt}"
                            android:enabled="false"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/petWeighingDateTextField"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:layout_marginStart="2dp"
                        android:hint="@string/pet_weighing_date_header">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/petWeighingDateText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@{viewPetViewModel.petDetails.latestPetWeightHowLongAgo}"
                            android:enabled="false"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/associated_tags_fragment_container_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:name="com.hfad.petlogger.screens.sections.associatedentities.AssociatedTagsDisplayFragment"
                    tools:layout="@layout/fragment_associated_tags_display" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</layout>