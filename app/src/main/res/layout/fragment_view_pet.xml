<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".screens.pet.viewpet.ViewPetFragment">
    <data>
        <variable
            name="viewPetViewModel"
            type="com.hfad.petlogger.screens.pet.viewpet.ViewPetViewModel" />
        <variable
            name="photoListViewModel"
            type="com.hfad.petlogger.screens.photo.FullGalleryViewModel" />
        <variable
            name="eventListViewModel"
            type="com.hfad.petlogger.screens.event.EventListViewModel" />
        <variable
            name="associatedPetWeightsDisplayViewModel"
            type="com.hfad.petlogger.screens.sections.associatedentities.AssociatedPetWeightsDisplayViewModel" />
        <variable
            name="noteListViewModel"
            type="com.hfad.petlogger.screens.note.NoteListViewModel" />
        <variable
            name="associatedTagsDisplayViewModel"
            type="com.hfad.petlogger.screens.sections.associatedentities.AssociatedTagsDisplayViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/viewPetTopAppBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/viewPetTopAppBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@{viewPetViewModel.petDetails.petName}"
                app:subtitle="@string/viewing_pet"
                app:titleCentered="true"
                app:menu="@menu/view_entity_top_app_bar"
                app:navigationIcon="@drawable/baseline_arrow_back_24"
                app:subtitleCentered="true"/>
        </com.google.android.material.appbar.AppBarLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/viewPetTopAppBarLayout"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:orientation="vertical">
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tabPaddingStart="8dp"
                app:tabPaddingEnd="8dp"
                app:tabPaddingTop="0dp"
                app:tabPaddingBottom="0dp"
                app:tabMode="fixed"
                app:tabGravity="fill"/>
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>