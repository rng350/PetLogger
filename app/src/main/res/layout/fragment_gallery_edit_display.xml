<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="displayViewModel"
            type="com.hfad.guineapiglog.photoselection.GalleryEditDisplayViewModel"/>

        <variable
            name="galleryViewModel"
            type="com.hfad.guineapiglog.photoselection.GalleryViewModel"/>
    </data>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/photos_header"
                android:textAppearance="?attr/textAppearanceHeadline4"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/old_photos_header"
                android:textAppearance="?attr/textAppearanceHeadline6"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/old_photos_selection"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="3"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_photos_header"
                android:textAppearance="?attr/textAppearanceHeadline6"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/new_photos_selection"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="3"/>

            <LinearLayout
                android:id="@+id/galleryPickerSpace"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:layout_weight="1">
                <include
                    android:id="@+id/galleryPicker"
                    layout="@layout/fragment_gallery_picker"
                    app:viewModel="@{galleryViewModel}"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>