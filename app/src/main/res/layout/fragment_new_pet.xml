<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".NewPetFragment">
    <data>
        <variable
            name="newPetViewModel"
            type="com.hfad.petlogger.NewPetViewModel" />
        <variable
            name="petProfilePhotoSelectionViewModel"
            type="com.hfad.petlogger.MediaSingleSelectionViewModel"/>
        <variable
            name="photoSelectionViewModel"
            type="com.hfad.petlogger.MediaSelectionViewModel" />
        <variable
            name="noteMultiSelectionViewModel"
            type="com.hfad.petlogger.NoteMultiSelectionViewModel" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/pet_profile_pic_selection_fragment_container_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:name="com.hfad.petlogger.MediaSingleSelectionFragment"
                    tools:layout="@layout/fragment_media_single_selection" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/petName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/pet_name_header">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:text="@={newPetViewModel.petName}" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/petSpecies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/pet_species_header"
                        android:layout_weight="1">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:text="@={newPetViewModel.petSpecies}" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/petBreed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/pet_breed_header"
                        android:layout_weight="1">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:text="@={newPetViewModel.petBreed}" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <RadioGroup
                    android:id="@+id/petSexSelection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/petSexMale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pet_sex_male" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/petSexFemale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pet_sex_female" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/petSexOther"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pet_sex_other" />
                </RadioGroup>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/petBirthDateLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/pet_birthdate">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/petBirthDateDisplay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:enabled="false"
                            android:focusable="true"
                            android:inputType="text"
                            android:text="@{newPetViewModel.petDOB.dateDisplay}" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/addPetBirthDateButton"
                        android:layout_width="50dp"
                        android:layout_height="match_parent"
                        app:icon="@drawable/baseline_edit_24" />
                </LinearLayout>
            </LinearLayout>

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/media_selection_fragment_container_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:name="com.hfad.petlogger.MediaSelectionFragment"
                tools:layout="@layout/fragment_media_selection" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/note_selection_fragment_container_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:name="com.hfad.petlogger.NoteMultiSelectionDisplayFragment"
                tools:layout="@layout/fragment_note_multi_selection_display" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/submit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/submit"/>

                <Button
                    android:id="@+id/clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clear"/>

                <Button
                    android:id="@+id/back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/back" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</layout>