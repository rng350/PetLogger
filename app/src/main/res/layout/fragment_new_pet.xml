<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".NewPetFragment">
    <data>
        <variable
            name="viewModel"
            type="com.hfad.guineapiglog.NewPetViewModel" />
        <variable
            name="galleryViewModel"
            type="com.hfad.guineapiglog.photoselection.GalleryViewModel" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/petPhoto"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:adjustViewBounds="false"
                    android:scaleType="centerCrop" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/petName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/pet_name_header">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:text="@={viewModel.petName}" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/petSpecies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/pet_species_header"
                        android:layout_weight="1">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:text="@={viewModel.petSpecies}" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/petBreed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/pet_breed_header"
                        android:layout_weight="1">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:text="@={viewModel.petBreed}" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <RadioGroup
                    android:id="@+id/petSexSelection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/petSexMale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pet_sex_male" />

                    <RadioButton
                        android:id="@+id/petSexFemale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pet_sex_female" />

                    <RadioButton
                        android:id="@+id/petSexOther"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pet_sex_other" />
                </RadioGroup>

                <TextView
                    android:id="@+id/petBirthDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pet_birthdate"
                    android:textSize="20sp" />

                <Button
                    android:id="@+id/inputDOBButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{@string/input_pet_dob(viewModel.petDOB.dateDisplay)}" />

                <!--<EditText
                    android:id="@+id/additionalNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:hint="@string/pet_additional_notes"/>-->
            </LinearLayout>

            <LinearLayout
                android:id="@+id/galleryPickerSpace"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:layout_weight="1">
                <include
                    android:id="@+id/galleryPicker"
                    layout="@layout/fragment_gallery_picker"
                    app:viewModel="@{galleryViewModel}"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/submit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/submit"/>

                <Button
                    android:id="@+id/back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/back" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</layout>