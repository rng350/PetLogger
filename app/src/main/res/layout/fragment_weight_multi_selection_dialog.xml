<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".screens.weight.weightmultiselection.WeightMultiSelectionDialogFragment">
    <data>
        <variable
            name="viewModel"
            type="com.hfad.petlogger.screens.weight.weightmultiselection.WeightMultiSelectionViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/dialogFragmentAppBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
<!--            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/dialogFragmentAppBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="Select Weights"
                app:subtitle="@{@string/amt_without_limit_selected(String.valueOf(viewModel.selectionTracker.prospectiveSelection.size()))}"
                app:titleCentered="true"
                app:subtitleCentered="true"/>-->
        </com.google.android.material.appbar.AppBarLayout>

        <ScrollView
            android:id="@+id/weights_list_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/weights_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:gravity="top"/>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">
            <androidx.appcompat.widget.SearchView
                android:id="@+id/search_view"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:queryHint="@string/enter_tag"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:text="@string/cancel"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/okay_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="@string/ok" />
        </LinearLayout>
    </LinearLayout>
</layout>