<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".screens.note.editnote.EditNoteFragment">

    <data>
        <variable
            name="editNoteViewModel"
            type="com.hfad.petlogger.screens.note.editnote.EditNoteViewModel" />
        <variable
            name="petMultiSelectionViewModel"
            type="com.hfad.petlogger.screens.pet.petmultiselection.PetMultiSelectionViewModel" />
        <variable
            name="eventMultiSelectionViewModel"
            type="com.hfad.petlogger.screens.event.eventmultiselection.EventMultiSelectionViewModel" />
        <variable
            name="weightMultiSelectionViewModel"
            type="com.hfad.petlogger.screens.weight.weightmultiselection.WeightMultiSelectionViewModel" />
        <variable
            name="mediaSelectionViewModel"
            type="com.hfad.petlogger.screens.photo.mediaselection.MediaSelectionViewModel" />
        <variable
            name="tagMultiSelectionViewModel"
            type="com.hfad.petlogger.screens.tag.tagmultiselection.TagMultiSelectionViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/editNoteTopAppBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/editNoteTopAppBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@{editNoteViewModel.noteTitle}"
                app:subtitle="@string/editing_note_details"
                app:titleCentered="true"
                app:menu="@menu/edit_entity_top_app_bar"
                app:navigationIcon="@drawable/baseline_arrow_back_24"
                app:subtitleCentered="true"/>
        </com.google.android.material.appbar.AppBarLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/editNoteTopAppBarLayout"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:orientation="vertical">
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tabMode="fixed"
                app:tabGravity="fill"/>
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>