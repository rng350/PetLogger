<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".screens.note.viewnote.ViewNoteDetailsFragment">
    <data>
        <variable
            name="viewNoteViewModel"
            type="com.hfad.petlogger.screens.note.viewnote.ViewNoteViewModel" />
        <variable
            name="associatedTagsDisplayViewModel"
            type="com.hfad.petlogger.screens.sections.associatedentities.AssociatedTagsDisplayViewModel" />
    </data>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/noteTitleTextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/title">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/noteTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{viewNoteViewModel.note.title}"
                    android:enabled="false"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/noteDetailsTextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/note_details">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/noteDetailsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{viewNoteViewModel.note.details}"
                    android:enabled="false"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/noteLastUpdatedTextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/last_updated">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/noteLastUpdatedText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="1"
                    android:text="@{viewNoteViewModel.lastUpdatedDateDisplay}"
                    android:enabled="false"/>
            </com.google.android.material.textfield.TextInputLayout>

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/associated_tags_fragment_container_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:name="com.hfad.petlogger.screens.sections.associatedentities.AssociatedTagsDisplayFragment"
                tools:layout="@layout/fragment_associated_tags_display" />
        </LinearLayout>
    </ScrollView>
</layout>