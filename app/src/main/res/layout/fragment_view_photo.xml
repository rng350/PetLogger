<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".screens.photo.viewphoto.ViewPhotoFragment">

    <data>
        <import type="com.hfad.petlogger.common.util.DataBindingConverter"/>
        <variable
            name="viewPhotoViewModel"
            type="com.hfad.petlogger.screens.photo.viewphoto.ViewPhotoViewModel" />
        <variable
            name="petListViewModel"
            type="com.hfad.petlogger.screens.pet.PetListViewModel" />
        <variable
            name="eventListViewModel"
            type="com.hfad.petlogger.screens.event.EventListViewModel" />
        <variable
            name="noteListViewModel"
            type="com.hfad.petlogger.screens.note.NoteListViewModel" />
        <variable
            name="associatedTagsDisplayViewModel"
            type="com.hfad.petlogger.screens.sections.associatedentities.AssociatedTagsDisplayViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/viewPhotoTopAppBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/viewPhotoTopAppBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@{viewPhotoViewModel.photo.title}"
                app:subtitle="@string/viewing_photo_details"
                app:titleCentered="true"
                app:menu="@menu/view_entity_top_app_bar"
                app:navigationIcon="@drawable/baseline_arrow_back_24"
                app:subtitleCentered="true"/>
        </com.google.android.material.appbar.AppBarLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/viewPhotoTopAppBarLayout"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:orientation="vertical">
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tabMode="fixed"
                app:tabGravity="fill"/>
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>